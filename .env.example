# Documentation only: the launcher does not automatically load this file.
# Set these environment variables in your terminal/process manager.
SAP_PLANNER_PROVIDER=fake
# For openai_compatible, set an explicit supported model and provider key.
SAP_PLANNER_MODEL=
SAP_PLANNER_BASE_URL=https://api.openai.com/v1
SAP_PLANNER_API_KEY=
SAP_PLANNER_RESPONSE_FORMAT=json_schema
SAP_PLANNER_TIMEOUT=30
SAP_PLANNER_MAX_TOKENS=2048
